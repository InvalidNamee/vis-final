1782\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"317.2812133773716\" cy=\"229.36825284353532\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"335.95611374848716\" cy=\"217.25498207483014\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"349.17435921588077\" cy=\"222.36403913066997\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"345.19768707074223\" cy=\"211.34562256484884\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"318.8815740121289\" cy=\"233.9816426270059\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"445.7607808161589\" cy=\"138.34994719941304\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"470.1827639546977\" cy=\"105.06178449689202\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"403.9419794204797\" cy=\"165.80152580164275\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"296.9571399712159\" cy=\"238.8363159785336\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"459.6738353295331\" cy=\"111.92703899843727\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"335.48291470629675\" cy=\"216.89975417945936\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"388.902041022275\" cy=\"173.756158897582\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><circle cx=\"347.0054791497625\" cy=\"210.69722232932025\" r=\"2.8\" fill=\"#21796a\" opacity=\".6\"/><path d=\"M312.91 237.49 L488.22 91.05\" stroke=\"#b96b38\" stroke-width=\"2.5\" fill=\"none\"/><path d=\"M82 50V274H720\" fill=\"none\" stroke=\"#789b8b\"/><text x=\"400\" y=\"337\" text-anchor=\"middle\" font-size=\"16\" fill=\"#355a4b\">东向 / m</text></svg></div><div class=\"figcap\"><b>图 2</b><span>默认教学参数的实际计算：事件位置 / PCA主轴。方位误差 0.13°；事件云主轴跨度 264.91m；同分位跨度误差 0.02m。图示由同包model.js计算，交互演示可改变参数重算。</span></div>"
