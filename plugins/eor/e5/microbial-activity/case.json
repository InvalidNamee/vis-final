      "steps": [
        {
          "name": "工况资料整理",
          "role": "数据",
          "do": "核对盐度、初始营养浓度与培养活性，按时间保留后半段观测。",
          "effect": "形成培养时长：30 天；拟合 / 评价：15 / 15 天；补给时机：第 15—25 天的处理任务。"
        },
        {
          "name": "营养耦合活性参数拟合",
          "role": "计算",
          "do": "逐日积分简化Monod生长：净增率=μN/(1+N)×盐度抑制−衰亡，营养随生物量消耗。前15日观测网格拟合μ和衰亡，后15日仅评价；搜索15–25日补营养时机，最大化第30日活性。",
          "effect": "形成可与原始观测或备选方案逐项对照的微生物采油菌群活性预测结果。"
        },
        {
          "name": "留后活性预测评价",
          "role": "评价",
          "do": "冻结前15日拟合参数，对后15日活性计算误差，再比较各补给时机的第30日响应。",
          "effect": "区分历史拟合、后期预测和补给情景。"
        },
        {
          "name": "结果对照与交付",
          "role": "评价",
          "do": "交付拟合参数、后15天误差与补给时机响应；核对活性增长是否受营养耗尽限制。",
          "effect": "为菌群活性与营养补给估计提供可追溯的候选、误差或约束依据。",
          "trap": "生长与衰亡参数可能相互补偿，短期拟合相近也可能得到不同后期走势。"
        }
      ],
      "metrics": {
