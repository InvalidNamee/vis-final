  "tabs": {
    "background": {
      "label": "专业背景",
      "lede": "生产计划人员需要依据单井近期产量安排未来生产，但逐井手工试配递减曲线费时且选型口径难统一。AI流程以可解释的递减曲线为基线，自动拟合候选、按后续时段选型，交付未来日产曲线、累计预测量和留出误差供计划人员编制方案。",
      "judge": [
        {
          "label": "任务类型",
          "value": "时序预测",
          "desc": "自动比较指数与双曲递减候选，延拓单井产量",
          "html": "<span style=\"color:var(--c-ts)\">时序预测</span>"
        },
        {
          "label": "数据门槛",
          "value": "120—180 天",
          "desc": "单井日产量、开井状态及措施日期"
        },
        {
          "label": "收益",
          "value": "14.34 → 2.11 m³/d",
          "desc": "末40天产量MAE：末7个训练日均值 → 递减曲线",
          "html": "<b style=\"color:var(--jade-d);font-family:var(--mono)\">14.34 → 2.11 m³/d</b>"
        },
        {
          "label": "难度",
          "value": "中",
          "desc": "停井和措施引起趋势切换，稳定递减段需单独整理",
          "html": "<span class=\"dtag\" data-d=\"中\">难度 中</span>"
        }
      ],
