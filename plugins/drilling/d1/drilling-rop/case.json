      "steps": [
        {
          "name": "合成数据生成与井组划分",
          "role": "数据",
          "do": "固定种子生成多口虚拟井的钻压、转速、流量、岩层与合成观测钻速；按井标识分训练、验证、测试集。",
          "effect": "明确本例处理规模与资料分组：虚拟井数 18 口；数据记录 1080 条；训练 / 验证 / 测试 12 / 3 / 3 口井；模型输入 钻压、转速、排量、岩层；参数网格 1271 组；模型选择 验证井 MAE。"
        },
        {
          "name": "特征构造与回归训练",
          "role": "模型",
          "do": "先按固定尺度构造 WOB、RPM、Q 的一次、平方及交互项，加入岩层 one-hot 和岩层与参数交互；仅用训练集统计量标准化特征并拟合岭回归。",
          "effect": "保留特征构造与回归训练的中间结果，供下一环节核对与比较。"
        },
        {
          "name": "模型选择与独立测试",
          "role": "评价",
          "do": "以验证井 MAE 选择正则强度，保留所选训练模型且不重新拟合；在独立测试井计算 MAE 与 R²，绘制合成观测对预测的散点图。",
          "effect": "保留模型选择与独立测试的中间结果，供下一环节核对与比较。"
        },
        {
          "name": "约束参数网格搜索",
          "role": "优化",
          "do": "选择流量和岩层，调整钻压与转速上限；在演示采样范围和上限的交集内，逐点用冻结模型预测 WOB/RPM 网格。",
          "effect": "保留约束参数网格搜索的中间结果，供下一环节核对与比较。"
        },
