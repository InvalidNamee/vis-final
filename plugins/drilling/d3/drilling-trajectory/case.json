      "steps": [
        {
          "name": "测段响应辨识",
          "role": "数据",
          "do": "24 条独立记录回归增益与自然漂移。",
          "effect": "建立可核对的轻量预测模型。",
          "trap": "校准模型不随目标值改变，也不读取未来扰动。"
        },
        {
          "name": "有限动作序列搜索",
          "role": "算法",
          "do": "枚举三段共 729 个指令序列并预测测段终点。",
          "effect": "比较未来响应而不是只纠正当前误差。",
          "trap": "短预测窗不保证全局最优。"
        },
        {
          "name": "约束筛选与执行",
          "role": "控制",
          "do": "剔除预测曲率和井斜越界序列，只执行首个动作。",
          "effect": "限制教学模型中的急弯并滚动纠偏。",
          "trap": "实际扰动可能使曲率超出预测上限。"
        },
        {
          "name": "轨迹对比与复核",
          "role": "评价",
          "do": "按相同初态和扰动运行零指令基线，核对终点距靶与实际曲率。",
          "effect": "同时显示跟踪效果与约束偏差。",
          "trap": "基线没有控制动作，不代表工程师的最佳手动策略。"
        }
