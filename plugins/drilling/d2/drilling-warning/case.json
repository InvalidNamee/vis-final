      "steps": [
        {
          "name": "工况与正常段选择",
          "role": "数据",
          "do": "固定合成恒定钻进段，分开校准与监测时间。",
          "effect": "减少泵启停等工况切换混淆。",
          "trap": "正常段污染会使后续偏移被低估。"
        },
        {
          "name": "通道基线标定",
          "role": "算法",
          "do": "仅用前 60 条求均值与标准差。",
          "effect": "不同量纲的变化可比较。",
          "trap": "禁止用事件后数据更新正常尺度。"
        },
        {
          "name": "因果时序评分",
          "role": "算法",
          "do": "递推 EWMA，取最大绝对偏移并统计连续超限。",
          "effect": "保留缓慢漂移并标明贡献最大的通道。",
          "trap": "分数不能当概率，噪声和采样间隔影响阈值。"
        },
        {
          "name": "预警复核与评价",
          "role": "人工",
          "do": "按已观测评价窗统计 TP、FP、FN、TN 与首次有效前兆报警。",
          "effect": "把误报、漏报和提前量同时展示。",
          "trap": "正常段误报不能计入有效提前量。"
        }
      ],
      "metrics": {
