        [
          "短 / 长窗",
          "8 / 50 点"
        ]
      ],
      "steps": [
        {
          "name": "样本与参照整理",
          "role": "数据",
          "do": "240点合成单道，采样间隔2 ms，参考初至第85点即170 ms。初至后使用衰减正弦包络，前段只有合成噪声。",
          "effect": "明确本例处理规模与资料分组：单道长度 240 点；采样间隔 2 ms；短 / 长窗 8 / 50 点。"
        },
        {
          "name": "STA/LTA因果能量触发",
          "role": "计算",
          "do": "在当前点及之前8点范围求短窗平方能量均值，50点范围求长窗平方能量均值。前50点不触发，STA/LTA首次大于1+5t的位置为拾取点；不参考初至标签进行触发。",
          "effect": "形成与输入位置对应的预测、评分或候选结果，供后续逐项对照。"
        },
        {
          "name": "候选与误差对照",
          "role": "评价",
          "do": "拾取时间=样本索引×2 ms；绝对误差=|拾取索引−85|×2 ms。没有触发时显示未定义，不能将漏拾记为0误差。",
          "effect": "把候选与参考逐项比较，定位误报、漏报或数值偏差。"
        },
        {
          "name": "解释成果复核",
          "role": "交付",
          "do": "交付首次触发时间及参考误差；检查提前触发和未触发的波形，列入人工补拾清单。",
