          "8 / 4 工区批次"
        ]
      ],
      "steps": [
        {
          "name": "样本与参照整理",
          "role": "数据",
          "do": "360个合成地震属性窗口，12个虚拟工区批次。三维特征是归一化RMS振幅、反射连续性和归一化主频；类别为平行强反射、杂乱反射和弱反射，均非真实沉积相标签。",
          "effect": "明确本例处理规模与资料分组：属性窗口 360 个；属性维度 3 项；训练 / 评价 8 / 4 工区批次。"
        },
        {
          "name": "地震属性最近质心",
          "role": "计算",
          "do": "按工区批次0—7训练，8—11评价。训练集统计量标准化三个属性，求三类平均属性质心，以标准化欧氏距离分类。未实现三维卷积或弱监督学习。",
          "effect": "形成与输入位置对应的预测、评分或候选结果，供后续逐项对照。"
        },
        {
          "name": "候选与误差对照",
          "role": "评价",
          "do": "异工区准确率和3×3混淆矩阵；评价样本120，训练样本240。类别序号仅绘图编码，不表示连续物性。",
          "effect": "把候选与参考逐项比较，定位误报、漏报或数值偏差。"
        },
        {
          "name": "解释成果复核",
          "role": "交付",
          "do": "交付反射相类别及混淆矩阵；结合井旁标定检查相带边界与类别过渡。",
          "effect": "形成地震相带候选划分的复核记录与后续检查清单。",
          "trap": "不同地质成因可能给出相近属性，反射相类别需要进一步地质标定。"
        }
