14.41\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"208.34\" cy=\"220.27\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"142.87\" cy=\"153.98\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"133.66\" cy=\"201.54\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"162.95\" cy=\"130.69\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"217.88\" cy=\"159.68\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"335.39\" cy=\"189.19\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"253.67\" cy=\"172.37\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"256.59\" cy=\"143.68\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"280.11\" cy=\"138.38\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"154.61\" cy=\"169.33\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"271.21\" cy=\"129.14\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"240.54\" cy=\"137.29\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"180.86\" cy=\"144.99\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"214.04\" cy=\"202.83\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"247.05\" cy=\"190.63\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"164.81\" cy=\"208.26\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"193.85\" cy=\"131.11\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"112.00\" cy=\"162.10\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"212.38\" cy=\"179.63\" r=\"2.6\" fill=\"#7654b2\"/><text x=\"432\" y=\"22\" font-size=\"15\" fill=\"#7654b2\">弱反射</text><text class=\"plot-x-label\" x=\"391\" y=\"315\" text-anchor=\"middle\" font-size=\"16\">归一化RMS振幅</text><text class=\"plot-y-label\" x=\"24\" y=\"153\" transform=\"rotate(-90 24 153)\" text-anchor=\"middle\" font-size=\"15\">连续性属性</text></g></svg></div><div class=\"figcap\"><b>图 1</b><span>图为默认参数下实际生成的合成输入或预测关系；完整交互及误差由“案例演示”实时计算。</span></div>"
