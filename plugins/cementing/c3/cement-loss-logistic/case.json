        },
        {
          "name": "正则逻辑回归拟合",
          "role": "算法",
          "do": "训练集梯度下降拟合截距与三项特征；L2强度固定。",
          "effect": "保留正则逻辑回归拟合的中间结果，供下一环节核对与比较。"
