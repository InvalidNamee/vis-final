.25 L359.11 94.91 L365.56 101.06 L372.00 96.40 L378.44 112.89 L384.89 97.84 L391.33 126.71 L397.78 125.74 L404.22 76.26 L410.67 78.55 L417.11 86.89 L423.56 94.92 L430.00 89.81 L436.44 100.19 L442.89 82.92 L449.33 105.56 L455.78 114.45 L462.22 112.98 L468.67 112.34 L475.11 131.84 L481.56 108.06 L488.00 127.65 L494.44 130.15 L500.89 133.94 L507.33 145.83 L513.78 143.55 L520.22 151.30 L526.67 161.98 L533.11 165.97 L539.56 157.08 L546.00 146.88 L552.44 169.69 L558.89 168.12 L565.33 167.97 L571.78 190.98 L578.22 196.45 L584.67 190.65 L591.11 183.42 L597.56 184.27 L604.00 176.75 L610.44 201.71 L616.89 186.49 L623.33 198.79 L629.78 185.38 L636.22 207.03 L642.67 203.46 L649.11 197.28 L655.56 209.01 L662.00 204.13 L668.44 200.54 L674.89 205.29 L681.33 218.69 L687.78 218.56 L694.22 214.43 L700.67 194.80 L707.11 206.73 L713.56 220.15 L720.00 211.18\" stroke=\"var(--clay)\" stroke-width=\"2.5\" fill=\"none\"/><path d=\"M82.00 166.41 L88.44 168.30 L94.89 153.22 L101.33 158.47 L107.78 154.24 L114.22 167.83 L120.67 160.98 L127.11 137.50 L133.56 153.98 L140.00 151.56 L146.44 117.60 L152.89 116.67 L159.33 114.61 L165.78 120.45 L172.22 131.50 L178.67 110.39 L185.11 106.63 L191.56 102.54 L198.00 108.91 L204.44 86.96 L210.89 107.28 L217.33 104.07 L223.78 96.63 L230.22 96.25 L236.67 100.94 L243.11 83.28 L249.56 107.59 L256.00 84.44 L262.44 83.69 L268.89 104.22 L275.33 100.01 L281.78 85.85 L288.22 89.54 L294.67 97.97 L301.11 93.62 L307.56 74.76 L314.00 85.23 L320.44 78.54 L326.89 97.81 L333.33 101.87 L339.78 106.75 L346.22 115.17 L352.67 88.64 L359.11 99.23 L365.56 105.19 L372.00 98.68 L378.44 116.52 L384.89 97.71 L391.33 126.52 L397.78 121.89 L404.22 75.58 L410.67 78.00 L417.11 92.33 L423.56 99.14 L430.00 92.89 L436.44 106.83 L442.89 87.10 L449.33 111.54 L455.78 120.32 L462.22 113.22 L468.67 114.54 L475.11 130.09 L481.56 109.11 L488.00 132.98 L494.44 134.56 L500.89 135.69 L507.33 148.78 L513.78 149.72 L520.22 152.76 L526.67 164.96 L533.11 169.92 L539.56 163.26 L546.00 148.41 L552.44 170.35 L558.89 167.62 L565.33 173.79 L571.78 191.76 L578.22 200.66 L584.67 190.70 L591.11 190.81 L597.56 188.85 L604.00 184.88 L610.44 205.75 L616.89 193.39 L623.33 203.50 L629.78 191.64 L636.22 211.45 L642.67 209.66 L649.11 201.28 L655.56 214.34 L662.00 206.65 L668.44 204.96 L674.89 205.13 L681.33 222.21 L687.78 224.15 L694.22 215.04 L700.67 195.79 L707.11 213.02 L713.56 224.68 L720.00 210.40\" stroke=\"var(--jade)\" stroke-width=\"2.5\" fill=\"none\"/><path d=\"M82 50V274H720\" fill=\"none\" stroke=\"var(--ink-4)\"/><text x=\"400\" y=\"337\" text-anchor=\"middle\" font-size=\"16\" fill=\"var(--jade-d)\">分钟序号</text></svg></div><div class=\"figcap\"><b>图 2</b><span>默认教学参数的实际计算：液位真值 / 雷达读数 / 加权融合。雷达MAE 0.23m；视觉MAE 0.26m；融合MAE 0.22m。图示由同包model.js计算，交互演示可改变参数重算。</span></div>"
        },
        {
          "no": 3,
          "en": "DATA",
          "title": "同步液位与校尺记录",
          "html": "<p style=\"margin-bottom:14px\">试点准备 7—14 天同步记录，覆盖进罐、出罐、静置及不同照明条件，保留雷达值、视频刻度读数、时间戳与人工校尺结果。校尺数据用于比较各来源误差，静置段可估计噪声。演示生成 100 个合成液位点，通过视觉噪声和雷达漂移控件观察观测质量变化。</p><div class=\"checklist\"><div class=\"cl-head\"><span>数据准备清单 · 5 项</span><span class=\"cl-prog\"><span id=\"cl-txt\">0 / 5</span><span class=\"cl-bar\"><i id=\"cl-fill\"></i></span></span></div><div class=\"cl-item\" data-cl=\"0\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--card)\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">罐区视频</span><span class=\"cl-s\">固定机位，日夜两套</span></span><span class=\"cl-n\">无需标注</span></div><div class=\"cl-item\" data-cl=\"1\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--card)\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">雷达液位</span><span class=\"cl-s\">连续测量</span></span><span class=\"cl-n\">作为交叉校验</span></div><div class=\"cl-item\" data-cl=\"2\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--card)\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">报警与处置记录</span><span class=\"cl-s\">事件</span></span><span class=\"cl-n\">作为标签</span></div><div class=\"cl-item\" data-cl=\"3\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--card)\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">人工复核记录</span><span class=\"cl-s\">保留复核对象、原始证据与修订结论</span></span><span class=\"cl-n\">雷达、视频刻度读数与人工校尺结果</span></div><div class=\"cl-item\" data-cl=\"4\"><span class=\"cl-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--card)\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12.5l5 5L20 6.5\"/></svg></span><span><span class=\"cl-t\">样本版本与评价明细</span><span class=\"cl-s\">按原始对象分组，保留评价记录与版本</span></span><span class=\"cl-n\">用于复查数值和追踪更新</span></div></div><p style=\"margin-top:18px\"><span class=\"kicker plain\" style=\"color:var(--ink-4)\">专业资料与数据依据</span></p><div class=\"refs\"><a class=\"ref\" href=\"https://www.eia.gov/energyexplained/oil-and-petroleum-products/refining-crude-oil-the-refining-process.php\">EIA：The refining process<span class=\"ar\">↗</span></a></div>"
        },
        {
          "no": 4,
          "en": "DIFFICULTY",
          "title": "来源漂移与权重维护",
          "html": "<div style=\"display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:2px\"><span class=\"dtag\" data-d=\"低\">难度 低</span><span class=\"small muted\">视频噪声与雷达漂移会改变来源可信度</span></div><div class=\"meter\"><i class=\"on\"></i><i class=\"\"></i><i class=\"\"></i></div><p>落地难度低，主要障碍是两类观测的可信度会随工况变化：雾气、反光影响视频，雷达漂移形成持续偏置。试点应分别检查随机噪声与长期偏移，定期用人工校尺更新来源评价。超差记录先核对同步和传感器状态，再结合进出罐计量检查收支，使不同证据各有明确用途。</p><p style=\"margin-top:18px\"><span class=\"kicker plain\" style=\"color:var(--ink-4)\">可借鉴的通用技术</span></p><div class=\"refs\"><a class=\"ref\" href=\"/method/cv\">目标检测<span class=\"ar\">↗</span></a><a class=\"ref\" href=\"/method/cv\">读数识别<span class=\"ar\">↗</span></a><a class=\"ref\" href=\"/method/cv\">多源交叉校验<span class=\"ar\">↗</span></a></div>"
        }
      ]
    },
    "workflow": {
      "label": "案例流程",
      "title": "储罐双源液位交叉监测",
      "lead": [
        "储罐管理人员需要融合雷达与视觉液位，并利用源间偏差发现单源漂移线索。 本例使用教学合成资料，案例规模与处理口径如下。"
      ],
      "stats": [
        [
          "观测时长",
          "100 点"
        ],
        [
          "液位来源",
          "雷达、视觉"
        ],
        [
          "融合规则",
          "逆方差加权"
        ],
        [
          "雷达噪声尺度",
          "0.08 m"
        ],
        [
          "雷达单源 MAE",
          "0.235 m"
        ],
        [
          "融合液位 MAE",
          "0.218 m"
        ]
      ],
      "steps": [
        {
          "name": "工况资料整理",
          "role": "数据",
          "do": "核对两路液位的单位和时间对应，设置各源噪声尺度与交叉偏差阈值。",
          "effect": "形成观测时长：100 点；液位来源：雷达、视觉；融合规则：逆方差加权的处理任务。"
        },
        {
          "name": "液位多源方差加权融合",
          "role": "计算",
          "do": "生成100点液位真值，雷达噪声尺度0.08 m、第50点后漂移；视频噪声由控件指定。按逆方差权重融合，比较两单源与融合MAE，源间差超阈值进入复核。",
          "effect": "形成可与原始观测或备选方案逐项对照的储罐液位与泄漏智能监控结果。"
        },
        {
          "name": "单源与融合误差对照",
          "role": "评价",
          "do": "对相同100点分别计算雷达、视觉和融合MAE，并标记两源差值超过阈值的位置。",
          "effect": "识别融合收益与单源漂移影响。"
        },
        {
          "name": "结果对照与交付",
          "role": "评价",
          "do": "交付双源及融合曲线、MAE与偏差复核点；检查漂移发生后权重是否过度依赖异常源。",
          "effect": "为储罐双源液位交叉监测提供可追溯的候选、误差或约束依据。",
          "trap": "逆方差权重依据噪声尺度，低随机噪声的漂移传感器仍可能占较大权重。"
        }
      ],
