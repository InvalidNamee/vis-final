17.91\" cy=\"77.06\" r=\"2.6\" fill=\"#bd602b\"/><circle cx=\"187.33\" cy=\"126.82\" r=\"2.6\" fill=\"#bd602b\"/><circle cx=\"392.69\" cy=\"54.86\" r=\"2.6\" fill=\"#bd602b\"/><circle cx=\"379.03\" cy=\"67.71\" r=\"2.6\" fill=\"#bd602b\"/><circle cx=\"151.29\" cy=\"93.27\" r=\"2.6\" fill=\"#bd602b\"/><circle cx=\"352.53\" cy=\"85.93\" r=\"2.6\" fill=\"#bd602b\"/><text x=\"230\" y=\"22\" font-size=\"15\" fill=\"#bd602b\">页岩</text><circle cx=\"670.00\" cy=\"162.20\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"632.89\" cy=\"150.08\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"621.36\" cy=\"169.68\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"457.03\" cy=\"173.96\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"573.87\" cy=\"194.14\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"492.07\" cy=\"116.68\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"546.90\" cy=\"153.68\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"458.40\" cy=\"162.28\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"393.37\" cy=\"181.14\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"434.14\" cy=\"181.87\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"576.14\" cy=\"111.91\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"596.04\" cy=\"204.25\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"610.78\" cy=\"182.18\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"564.95\" cy=\"143.74\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"476.03\" cy=\"156.37\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"529.18\" cy=\"184.75\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"462.65\" cy=\"172.56\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"605.19\" cy=\"134.71\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"507.01\" cy=\"159.96\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"521.20\" cy=\"140.43\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"436.80\" cy=\"228.56\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"498.41\" cy=\"235.89\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"413.93\" cy=\"153.01\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"402.04\" cy=\"212.48\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"439.85\" cy=\"123.89\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"510.72\" cy=\"160.13\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"662.35\" cy=\"197.03\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"556.90\" cy=\"176.00\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"560.66\" cy=\"140.13\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"591.02\" cy=\"133.50\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"429.08\" cy=\"172.19\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"579.54\" cy=\"121.94\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"539.96\" cy=\"132.14\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"462.94\" cy=\"141.77\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"505.76\" cy=\"214.09\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"548.36\" cy=\"198.83\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"442.24\" cy=\"220.88\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"479.72\" cy=\"124.41\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"335.02\" cy=\"163.16\" r=\"2.6\" fill=\"#7654b2\"/><circle cx=\"503.63\" cy=\"185.08\" r=\"2.6\" fill=\"#7654b2\"/><text x=\"390\" y=\"22\" font-size=\"15\" fill=\"#7654b2\">灰岩</text><text x=\"70\" y=\"309\" font-size=\"16\">近红外反射率</text><text x=\"70\" y=\"334\" font-size=\"15\">纵轴：短波红外1反射率</text></g></svg></div><figcaption>图为默认参数下实际生成的合成输入或预测关系；完整交互及误差由“案例演示”实时计算。</figcaption></figure><p>360 个模拟地表像元，12 个区域批次，每批30像元。三维输入分别为近红外、短波红外1、短波红外2反射率（无量纲）；砂岩/页岩/灰岩三类中心仅是教学设定，不是通用光谱库。</p>"
        },
        {
          "no": 2,
          "en": "METHOD",
          "title": "光谱最近质心",
          "html": "<p>批次0—7的240像元求三维训练均值与标准差；标准化后分别求三类质心。对批次8—11的120像元计算到各质心的平方欧氏距离，最小距离所属类为预测。没有空间后处理，也没有利用DEM。</p><p>准确率=预测类别等于参考类别的评价像元数/120；混淆矩阵行是真值，列为预测。噪声控件重建同一批参考类别的观测。</p><p>裸地光谱会受湿度、风化和植被影响；本例仅演示数值特征分类，不读取真实遥感影像，不识别地下油气。</p>"
        },
        {
          "no": 3,
          "en": "SOURCE",
          "title": "专业资料与合成假设",
          "html": "<p><a href=\"https://www.usgs.gov/science/remote-sensing-minerals\" target=\"_blank\" rel=\"noopener noreferrer\">Remote Sensing of Minerals</a> — U.S. Geological Survey，2021/持续维护。</p><p>USGS原始资料说明遥感可用于矿物识别与地质制图；本例三类中心和标签不是USGS实测资料。</p><p>数据、阈值、系数均为教学合成假设，资料不证明本例精度或收益。</p><p><a href=\"https://scikit-learn.org/stable/modules/neighbors.html\" target=\"_blank\" rel=\"noopener noreferrer\">算法原始文档</a>支持方法定义；本例为JavaScript轻量实现，不调用对应Python库。</p>"
        }
      ]
    },
    "workflow": {
      "label": "案例流程",
      "title": "裸露区岩性底图编制",
      "lead": [
        "解译人员需要把多光谱观测整理为砂岩、页岩、灰岩候选分区，为后续地质填图安排核查位置。 本例使用教学合成资料，案例规模与处理口径如下。"
      ],
      "stats": [
        [
          "光谱像元",
          "360 个"
        ],
        [
          "输入波段",
          "3 个"
        ],
        [
          "训练 / 评价",
          "240 / 120 个"
        ]
      ],
      "steps": [
        {
          "name": "观测资料整理",
          "role": "数据",
          "do": "360 个模拟地表像元，12 个区域批次，每批30像元。三维输入分别为近红外、短波红外1、短波红外2反射率（无量纲）；砂岩/页岩/灰岩三类中心仅是教学设定，不是通用光谱库。",
          "effect": "明确本例处理规模与资料分组：光谱像元 360 个；输入波段 3 个；训练 / 评价 240 / 120 个。"
        },
        {
          "name": "光谱最近质心",
          "role": "计算",
          "do": "批次0—7的240像元求三维训练均值与标准差；标准化后分别求三类质心。对批次8—11的120像元计算到各质心的平方欧氏距离，最小距离所属类为预测。没有空间后处理，也没有利用DEM。",
          "effect": "形成与输入位置对应的预测、评分或候选结果，供后续逐项对照。"
        },
        {
          "name": "候选与误差对照",
          "role": "评价",
          "do": "准确率=预测类别等于参考类别的评价像元数/120；混淆矩阵行是真值，列为预测。噪声控件重建同一批参考类别的观测。",
          "effect": "把候选与参考逐项比较，定位误报、漏报或数值偏差。"
        },
        {
          "name": "解释成果复核",
          "role": "交付",
          "do": "交付逐像元岩性候选及混淆矩阵；优先复核光谱重叠的类别，再与地表地质单元对照。",
          "effect": "形成裸露区岩性底图编制的复核记录与后续检查清单。",
          "trap": "同一岩性的反射率会随湿度与覆盖变化，容易被分到另一个岩性质心。"
        }
      ],
      "metrics": {
