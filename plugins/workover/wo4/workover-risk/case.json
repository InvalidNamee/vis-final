        [
          "参考漂移起点",
          "第 75 点后"
        ]
      ],
      "steps": [
        {
          "name": "工况资料整理",
          "role": "数据",
          "do": "核对扭矩观测顺序，从正常段计算基线均值与标准差并冻结。",
          "effect": "形成基线样本：前 40 点；监测方法：单侧 CUSUM；参考漂移起点：第 75 点后的处理任务。"
        },
        {
          "name": "单侧累积和异常监测",
          "role": "计算",
          "do": "前40个点拟合正常均值和标准差。随后单侧CUSUM S=max(0,S+z−0.5)因果递推。第75点后人为加入漂移，以观测点为单位统计误报和检出延迟。",
          "effect": "形成可与原始观测或备选方案逐项对照的修井作业风险预警结果。"
        },
        {
          "name": "误报与检出延迟评价",
          "role": "评价",
          "do": "区分参考漂移前的正常监测段和漂移后的异常段，核对首次报警位置与检出延迟。",
          "effect": "比较控制限变化带来的提前误报与报警滞后。"
        },
        {
          "name": "结果对照与交付",
          "role": "评价",
          "do": "交付累积和曲线、首次报警及延迟；结合磨铣进尺与工况变化复核异常原因。",
          "effect": "为磨铣扭矩异常监测提供可追溯的候选、误差或约束依据。",
          "trap": "连续正向冲击可抬高CUSUM并提前报警，应区分短时扰动和持续负荷变化。"
        }
      ],
