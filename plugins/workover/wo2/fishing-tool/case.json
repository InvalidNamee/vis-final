    "workflow": {
      "label": "案例流程",
      "title": "落物打捞工具比选",
      "lead": [
        "修井人员需要先按落物尺寸与最小通径筛选能下入、能抓取的工具，再比较井斜适应性。 本例使用教学合成资料，案例规模与处理口径如下。"
      ],
      "stats": [
        [
          "备选工具",
          "6 种"
        ],
        [
          "通径余量",
          "6 mm"
        ],
        [
          "工具方式",
          "内捞、外捞"
        ]
      ],
      "steps": [
        {
          "name": "工况资料整理",
          "role": "数据",
          "do": "核对落物外径、最小通径和井斜，分别列出内捞及外捞的抓取尺寸要求。",
          "effect": "形成备选工具：6 种；通径余量：6 mm；工具方式：内捞、外捞的处理任务。"
        },
        {
          "name": "尺寸约束与工具排序",
          "role": "计算",
          "do": "枚举6种合成工具。外捞按抓取外径区间、内捞按假设的落物内径0.78倍外径检查，并要求工具外径+6 mm不大于通径。可行工具按井斜适配损失和抓取区间中心距离排序。",
          "effect": "形成可与原始观测或备选方案逐项对照的落物打捞工具智能选型结果。"
        },
        {
          "name": "尺寸约束与排除核对",
          "role": "评价",
          "do": "逐项查看抓取区间、工具外径加6 mm余量及井斜损失；可行集合为空时保留全部排除原因。",
          "effect": "先确认能下入、能抓取，再比较可行工具的排序。"
        },
        {
          "name": "结果对照与交付",
          "role": "评价",
          "do": "交付可行工具排序和尺寸排除原因；复核内径假设及下入通道后确定待核查工具。",
          "effect": "为落物打捞工具比选提供可追溯的候选、误差或约束依据。",
          "trap": "落物变形或内径估计偏差会改变抓取条件，应补充落物结构资料。"
        }
      ],
      "metrics": {
        "title": "流程产出与评价口径",
